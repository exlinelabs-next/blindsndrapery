0:{"buildId":"YWt1B2-kU7XiPPhIBDuij","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"children":[["$","section",null,{"className":"relative h-[300px] w-full md:h-[420px] xl:h-[546px]","children":[["$","$L2",null,{"src":"/images/resources/knowledge-hero.webp","alt":"Well-maintained window treatments in a bright living room","fill":true,"className":"rounded-lg object-cover"}],["$","div",null,{"className":"absolute inset-0 flex items-center justify-center","children":["$","div",null,{"className":"flex items-center justify-center rounded-lg bg-white p-3 backdrop-blur-[25px]","children":["$","span",null,{"className":"font-mono text-[11px] uppercase leading-[16px] tracking-[1.1px] text-navy","children":"HOME > KNOWLEDGE BASE > How to Maintain Your Window Treatments Year-Round"}]}]}]]}],["$","section",null,{"className":"px-8 pb-[100px] md:px-12 xl:px-20","children":[["$","div",null,{"className":"flex flex-col items-center justify-between gap-4 pt-[22px] md:flex-row xl:px-[60px]","children":[["$","div",null,{"className":"flex items-center justify-center rounded-lg border border-black/36 px-2 py-2","children":["$","span",null,{"className":"text-[16px] leading-[23px] text-black","children":"Maintenance Tips"}]}],["$","p",null,{"className":"text-[14px] uppercase leading-[16px] tracking-[1.1px] text-navy","children":"JUNE 20, 2025"}],["$","p",null,{"className":"text-[14px] uppercase leading-[16px] tracking-[1.1px] text-navy","children":"06 MIN READ"}]]}],["$","div",null,{"className":"mx-auto flex max-w-[1040px] flex-col gap-12 pt-16 md:pt-16 xl:px-10 xl:pt-20","children":[["$","h1",null,{"className":"font-heading text-[28px] font-semibold leading-[36px] tracking-[-0.1296px] text-black md:text-[32px] md:leading-[40px] xl:text-[36px] xl:leading-[44px]","children":"How to Maintain Your Window Treatments Year-Round"}],["$","div",null,{"className":"flex flex-col gap-12","children":[["$","div","0",{"className":"flex flex-col items-start","children":[["$","h2",null,{"className":"font-heading text-[18px] font-semibold leading-[27px] tracking-[-0.0648px] text-navy","children":"1. Establish a Regular Dusting Routine"}],["$","div",null,{"className":"mt-4 flex flex-col gap-[23px] text-[16px] leading-[23px] text-navy","children":[["$","p","Dust is one of the most common enemies o",{"children":"Dust is one of the most common enemies of window treatments. In Florida's humid climate, dust can combine with moisture and create stubborn residue that becomes increasingly difficult to remove over time."}],["$","p","For blinds and shutters, use a microfibe",{"children":"For blinds and shutters, use a microfiber cloth or a specialized blind duster to wipe each slat individually. Work from top to bottom to prevent redistributing dust onto already-cleaned surfaces. For fabric shades and drapes, a vacuum with a soft brush attachment works best."}],["$","p","Aim to dust your window treatments at le",{"children":"Aim to dust your window treatments at least once every two weeks. High-traffic rooms or homes near the coast may benefit from weekly attention due to increased dust and salt air exposure."}]]}]]}],["$","div","1",{"className":"flex flex-col items-start","children":[["$","h2",null,{"className":"font-heading text-[18px] font-semibold leading-[27px] tracking-[-0.0648px] text-navy","children":"2. Seasonal Deep Cleaning"}],["$","div",null,{"className":"mt-4 flex flex-col gap-[23px] text-[16px] leading-[23px] text-navy","children":[["$","p","Beyond regular dusting, schedule a thoro",{"children":"Beyond regular dusting, schedule a thorough deep cleaning at least twice a year — ideally at the start of Florida's dry season and again before the humid summer months arrive."}],["$","p","For aluminum and faux wood blinds, you c",{"children":"For aluminum and faux wood blinds, you can remove them and soak in a bathtub with mild soap. Real wood blinds should never be soaked — instead, use a damp cloth with wood-safe cleaner. Fabric treatments may benefit from professional cleaning, especially if they've absorbed cooking odors or pet dander."}],"$L3"]}]]}],"$L4","$L5","$L6"]}]]}]]}]]}],null,"$L7"]}],"isPartial":"$@8","staleTime":"$9","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$9","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$9","varyParams":"$e"},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$9","varyParams":"$e"}],"isUpgradeableISRFallback":false,"a":"$@11","rootVaryParams":null,"needsRuntimeRequest":"$@12"}
