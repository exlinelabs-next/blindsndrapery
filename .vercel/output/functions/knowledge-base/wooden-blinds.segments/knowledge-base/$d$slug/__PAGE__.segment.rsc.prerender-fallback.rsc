0:{"buildId":"YWt1B2-kU7XiPPhIBDuij","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"children":[["$","section",null,{"className":"relative h-[300px] w-full md:h-[420px] xl:h-[546px]","children":[["$","$L2",null,{"src":"/images/resources/knowledge-hero.webp","alt":"Beautiful wooden blinds in a contemporary living space","fill":true,"className":"rounded-lg object-cover"}],["$","div",null,{"className":"absolute inset-0 flex items-center justify-center","children":["$","div",null,{"className":"flex items-center justify-center rounded-lg bg-white p-3 backdrop-blur-[25px]","children":["$","span",null,{"className":"font-mono text-[11px] uppercase leading-[16px] tracking-[1.1px] text-navy","children":"HOME > KNOWLEDGE BASE > Everything You Need to Know About Wooden Blinds"}]}]}]]}],["$","section",null,{"className":"px-8 pb-[100px] md:px-12 xl:px-20","children":[["$","div",null,{"className":"flex flex-col items-center justify-between gap-4 pt-[22px] md:flex-row xl:px-[60px]","children":[["$","div",null,{"className":"flex items-center justify-center rounded-lg border border-black/36 px-2 py-2","children":["$","span",null,{"className":"text-[16px] leading-[23px] text-black","children":"Wooden Blinds Tutorial"}]}],["$","p",null,{"className":"text-[14px] uppercase leading-[16px] tracking-[1.1px] text-navy","children":"FEBRUARY 22, 2025"}],["$","p",null,{"className":"text-[14px] uppercase leading-[16px] tracking-[1.1px] text-navy","children":"07 MIN READ"}]]}],["$","div",null,{"className":"mx-auto flex max-w-[1040px] flex-col gap-12 pt-16 md:pt-16 xl:px-10 xl:pt-20","children":[["$","h1",null,{"className":"font-heading text-[28px] font-semibold leading-[36px] tracking-[-0.1296px] text-black md:text-[32px] md:leading-[40px] xl:text-[36px] xl:leading-[44px]","children":"Everything You Need to Know About Wooden Blinds"}],["$","div",null,{"className":"flex flex-col gap-12","children":[["$","div","0",{"className":"flex flex-col items-start","children":[["$","h2",null,{"className":"font-heading text-[18px] font-semibold leading-[27px] tracking-[-0.0648px] text-navy","children":"1. Real Wood vs. Faux Wood"}],["$","div",null,{"className":"mt-4 flex flex-col gap-[23px] text-[16px] leading-[23px] text-navy","children":[["$","p","The first decision when considering wood",{"children":"The first decision when considering wooden blinds is whether to go with genuine wood or faux wood alternatives. Both offer the classic warmth and beauty of wood grain, but they differ significantly in performance and maintenance."}],["$","p","Real wood blinds are typically made from",{"children":"Real wood blinds are typically made from basswood, oak, or cherry. They're lighter, available in more stain options, and have the authentic look and feel that many homeowners prefer. However, they're more susceptible to warping and discoloration in humid environments."}],["$","p","Faux wood blinds are made from PVC, comp",{"children":"Faux wood blinds are made from PVC, composite materials, or vinyl. They're heavier but more durable, completely moisture-resistant, and typically cost 20-30% less. For Florida homes, faux wood is often the more practical choice without sacrificing visual appeal."}]]}]]}],["$","div","1",{"className":"flex flex-col items-start","children":[["$","h2",null,{"className":"font-heading text-[18px] font-semibold leading-[27px] tracking-[-0.0648px] text-navy","children":"2. Slat Sizes and Their Impact"}],["$","div",null,{"className":"mt-4 flex flex-col gap-[23px] text-[16px] leading-[23px] text-navy","children":[["$","p","Wooden blinds come in several slat width",{"children":"Wooden blinds come in several slat widths, each creating a different visual effect. The most common sizes are 1 inch, 2 inches, and 2.5 inches."}],"$L3","$L4"]}]]}],"$L5","$L6","$L7"]}]]}]]}]]}],null,"$L8"]}],"isPartial":"$@9","staleTime":"$a","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$a","varyParams":null},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$a