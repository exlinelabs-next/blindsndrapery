# WordPress backend origin (GraphQL at /graphql, REST at /wp-json)
NEXT_PUBLIC_WP_URL=

# WP Application Password for the GraphQL "allow only specific queries" restriction (server-only)
WP_GRAPHQL_USERNAME=
WP_GRAPHQL_APP_PASSWORD=

# Google reCAPTCHA v3, guarding the contact forms. The site key is public
# (it ships in the page); the secret verifies tokens server-side and must
# never be NEXT_PUBLIC_. Without the secret set, submissions are accepted
# unverified.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
